# Copy to .env.local and fill in as needed. All values have sensible defaults.

# Microsoft Clarity analytics project id. Analytics is disabled when unset.
NEXT_PUBLIC_CLARITY_ID=p077apilbh

# Currency-rate API host (fawazahmed0/currency-api pages.dev mirror).
# jsdelivr is always tried as an automatic fallback, so this is optional.
# NOTE: if you change this host, update connect-src in next.config.mjs' CSP.
NEXT_PUBLIC_CURRENCY_API_HOST=currency-api.pages.dev

# Yahoo Finance chart API host (server-side, used by /api/currencyChart).
YAHOO_FINANCE_HOST=query1.finance.yahoo.com
